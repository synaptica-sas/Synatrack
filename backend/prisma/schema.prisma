generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

// Origen del registro de horas: formulario clasico, grilla semanal (timesheet)
// o cronometro en vivo (tracker).
enum TimeEntrySource {
  MANUAL
  TIMESHEET
  // Historico: el cronometro escribia TIMER hasta el 2026-09-30. Ahora produce
  // TIMESHEET, porque es una forma de rellenar el timesheet y sus horas cuentan
  // en el informe igual que las demas. No quedan filas con este valor; se
  // conserva en el enum porque quitarlo en Postgres obliga a recrear el tipo.
  TIMER
}

enum AppRole {
  ADMIN
  PM
  CONSULTANT
  FINANCE
  VIEWER
}

enum ProjectType {
  FIXED_PRICE        // Llave en mano: precio fijo contractual
  TIME_AND_MATERIAL  // Bolsa de horas: factura por horas consumidas
  STAFFING           // Staffing: tarifa mensual por recurso asignado
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum FxRateType {
  SPOT     // Tasa puntual del día
  AVERAGE  // Promedio del período (mensual/trimestral)
  BUDGET   // Tasa presupuestada al inicio del año fiscal
}

enum AssignmentStatus {
  PLANNED    // Confirmada para el futuro
  ACTIVE     // En ejecución
  PARTIAL    // Asignación parcial activa
  COMPLETED  // Terminada normalmente
  CANCELLED  // Cancelada antes de iniciar
}

enum AllocationMode {
  PERCENTAGE // % de capacidad total
  HOURS      // Horas fijas por semana/mes
}

enum BlockType {
  VACATION
  SICK_LEAVE
  NATIONAL_HOLIDAY
  INTERNAL_BENCH
  TRAINING
  OTHER
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum HealthStatus {
  GREEN
  YELLOW
  RED
}

enum ProjectPhase {
  INITIATION
  PLANNING
  EXECUTION
  MONITORING
  CLOSING
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum RiskStatus {
  OPEN
  MITIGATED
  ACCEPTED
  CLOSED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChangeRequestType {
  SCOPE
  BUDGET
  SCHEDULE
  RESOURCE
  OTHER
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum AlertType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  MARGIN_BELOW_THRESHOLD
  ASSIGNMENT_ENDING
  CONSULTANT_OVERLOADED
  FORECAST_DEVIATION
  FX_RATE_MISSING
}

// ─── Modelos de negocio ────────────────────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  name            String
  company         String
  country         String
  currency        String
  budget          Decimal       @db.Decimal(14, 2)
  startDate       DateTime
  endDate         DateTime
  description     String?
  projectType     ProjectType   @default(TIME_AND_MATERIAL)
  status          ProjectStatus @default(ACTIVE)
  sellPrice       Decimal?      @db.Decimal(14, 2)
  sellCurrency    String        @default("USD")
  // Dos umbrales de margen bruto (decisión de negocio D-2). Nulos = "sin umbral
  // propio": se aplican los valores por defecto de la empresa declarados en
  // `utils/financial.ts` (30 % advertencia, 15 % crítico). Se mantienen nulables
  // a propósito para que cambiar el criterio de la empresa no obligue a reescribir
  // todas las filas. Invariante: crítico <= advertencia (validado en la ruta).
  marginWarningPct     Decimal?      @db.Decimal(5, 2)
  marginCriticalPct    Decimal?      @db.Decimal(5, 2)
  // Umbral de AVISO de presupuesto del proyecto (%). Nulo = "sin umbral
  // propio": se aplica `HealthThresholdConfig.budgetWarningPct`, el valor
  // general de la empresa (D-7). Antes era `@default(90)` NOT NULL, con lo que
  // ninguna fila podía heredar nada y el valor general nunca llegaba a usarse.
  // El nivel CRÍTICO ("presupuesto excedido") no es por proyecto: es general.
  budgetAlertPct       Decimal?      @db.Decimal(5, 2)
  // Gestión de proyecto
  healthStatus         HealthStatus  @default(GREEN)
  completionPct        Decimal?      @db.Decimal(5, 2)
  phase                ProjectPhase  @default(EXECUTION)
  projectManagerEmail  String?
  // Baseline
  baselineBudget       Decimal?      @db.Decimal(14, 2)
  baselineStartDate    DateTime?
  baselineEndDate      DateTime?
  baselineSetAt        DateTime?
  baselineSetBy        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  timeEntries    TimeEntry[]
  financialEntries FinancialEntry[]
  forecasts      Forecast[]
  assignments    Assignment[]
  snapshots      MonthlySnapshot[]
  alerts         Alert[]
  milestones     Milestone[]
  risks          Risk[]
  issues         Issue[]
  changeRequests ChangeRequest[]
  allowExtraHours Boolean         @default(true)
  extraHourEntries ExtraHourEntry[]
  estimations      Estimation[]
  activities       Activity[]
  delegations      ApprovalDelegation[]
  runningTimers    RunningTimer[]
}

model Consultant {
  id             String   @id @default(cuid())
  fullName       String
  email          String?
  role           String
  company        String?
  hourlyRate     Decimal? @db.Decimal(14, 2)
  rateCurrency   String   @default("USD")
  country        String?
  costPerMonth   Decimal? @db.Decimal(14, 2)
  skills         String[] @default([])
  seniority      String?  // "Junior" | "Mid" | "Senior" | "Lead"
  maxHoursPerDay Decimal? @db.Decimal(4, 2)
  active         Boolean  @default(true)
  allowWeekendWork Boolean @default(false)
  isInternal     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  timeEntries    TimeEntry[]
  forecasts      Forecast[]
  assignments    Assignment[]
  blocks         ConsultantBlock[]
  capacityConfig CapacityConfig?
  alerts         Alert[]
  identification String?
  extraHourEntries ExtraHourEntry[]
  activities       Activity[]
  runningTimer     RunningTimer?
  risks            Risk[]
}

model TimeEntry {
  id            String          @id @default(cuid())
  projectId     String
  consultantId  String
  workDate      DateTime
  // 4 decimales y no 2: con 2 el valor mas pequeno representable es 0.01 h,
  // o sea 36 segundos, asi que el cronometro no podia registrar un minuto sin
  // inflarlo. Con 4 la resolucion baja a 0.36 s.
  hours         Decimal         @db.Decimal(8, 4)
  note          String?
  status        TimeEntryStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  rejectionNote String?
  // Descripcion libre de la tarea (estilo Clockify). `note` se conserva para el
  // flujo de aprobacion existente; `description` es lo que el consultor escribe
  // en el timesheet o en el tracker.
  description   String?
  activityId    String?
  source        TimeEntrySource @default(MANUAL)
  // Solo para entradas creadas por el cronometro: inicio y fin reales.
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  activity   Activity?  @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([consultantId])
  @@index([status])
  @@index([workDate])
  @@index([activityId])
  @@index([consultantId, workDate])
}

// Cronometro en curso. Vive en la BD (no en el navegador) para que siga
// corriendo al cerrar el navegador o cambiar de equipo. Un consultor solo puede
// tener uno activo a la vez: de ahi el @unique en consultantId.
model RunningTimer {
  id           String   @id @default(cuid())
  consultantId String   @unique
  projectId    String
  activityId   String?
  description  String?
  startedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity   Activity?  @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

enum FinancialEntryType {
  EXPENSE
  REVENUE
}

// Movimientos financieros por proyecto: gastos e ingresos unificados en una sola
// tabla (discriminador `type`) para facilitar la reportería conjunta. Las rutas
// /api/expenses y /api/revenue siguen siendo independientes, cada una filtrando
// por su `type`.
model FinancialEntry {
  id          String             @id @default(cuid())
  projectId   String
  type        FinancialEntryType
  entryDate   DateTime
  // Nombre de la categoría, tomado del catálogo editable `FinancialCategory`
  // (decisión de negocio D-4). Se guarda el nombre, no una clave foránea: la
  // columna ya existía con texto libre en los gastos y cambiarla a FK obligaba a
  // migrar datos históricos. El renombrado de una categoría propaga el nuevo
  // nombre a las entradas que la usaban, en la misma transacción.
  // Puede ser nulo: los ingresos registrados antes de D-4 no tienen categoría.
  category    String?
  amount      Decimal            @db.Decimal(14, 2)
  currency    String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entryDate])
  @@index([type])
}

/// Catálogo editable de categorías financieras (decisión de negocio D-4).
///
/// Antes esto no existía: las categorías de gasto eran una constante escrita en
/// el frontend (`ExpensesTab.tsx`) y los ingresos simplemente no se
/// categorizaban. Era la misma trampa de siempre —un dato que el código usa y
/// nadie puede editar— que ya se corrigió con la jornada laboral (D-5).
///
/// El catálogo es único para los dos tipos de movimiento: `type` discrimina
/// igual que en `FinancialEntry`, así que añadir categorías de ingreso y poder
/// editar las de gasto es la misma pantalla y el mismo endpoint.
model FinancialCategory {
  id        String             @id @default(cuid())
  type      FinancialEntryType
  name      String
  /// Desactivar en vez de borrar conserva la categoría en los movimientos ya
  /// registrados y solo la retira de los formularios.
  active    Boolean            @default(true)
  /// Orden de aparición en los desplegables; a igualdad, alfabético.
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([type, name])
  @@index([type, active])
}

model Forecast {
  id             String   @id @default(cuid())
  projectId      String
  consultantId   String
  startDate      String   @default("") // ISO "YYYY-MM-DD" — fecha exacta de inicio
  endDate        String   @default("") // ISO "YYYY-MM-DD" — fecha exacta de fin
  hoursProjected Decimal  @db.Decimal(10, 2)
  hourlyRate     Decimal? @db.Decimal(14, 2)  // Costo consultor (lo que pagamos)
  sellRate       Decimal? @db.Decimal(14, 2)  // Tarifa de venta al cliente
  currency       String   @default("USD")
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([consultantId])
}

// ─── FX ────────────────────────────────────────────────────────────────────────

model FxConfig {
  id        String   @id @default(cuid())
  baseCode  String
  quoteCode String
  rate      Decimal  @db.Decimal(18, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Historial de tasas con fecha efectiva — evita recalcular el pasado con tasa actual
model FxRateHistory {
  id            String     @id @default(cuid())
  baseCode      String
  quoteCode     String
  rate          Decimal    @db.Decimal(18, 6)
  effectiveDate DateTime
  rateType      FxRateType @default(SPOT)
  source        String?    // "manual", "ecb", "banrep", etc.
  createdBy     String?    // email del usuario que registró la tasa
  createdAt     DateTime   @default(now())

  @@index([baseCode, quoteCode, effectiveDate])
  @@index([rateType])
}

// ─── Usuarios y roles ─────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  microsoftOid String?  @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photoUrl     String?
  bio          String?
  phrase       String?
  skills       String[] @default([])
  roles UserRole[]
  country      String?
}

model Role {
  id        String   @id @default(cuid())
  name      AppRole  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ─── Asignaciones y Capacidad ─────────────────────────────────────────────────

model Assignment {
  id             String           @id @default(cuid())
  projectId      String
  consultantId   String
  startDate      DateTime
  endDate        DateTime
  allocationMode AllocationMode   @default(PERCENTAGE)
  allocationPct  Decimal?         @db.Decimal(5, 2)   // 0..100 si mode=PERCENTAGE
  hoursPerPeriod Decimal?         @db.Decimal(8, 2)   // horas/semana o /mes si mode=HOURS
  periodUnit     String?          // "week" | "month"
  status         AssignmentStatus @default(PLANNED)
  role           String?
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Restrict)

  @@index([consultantId])
  @@index([projectId])
  @@index([startDate, endDate])
  @@index([status])
}

model ConsultantBlock {
  id           String    @id @default(cuid())
  consultantId String
  startDate    DateTime
  endDate      DateTime
  blockType    BlockType @default(OTHER)
  note         String?
  createdAt    DateTime  @default(now())

  consultant Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([consultantId, startDate, endDate])
}

/// Jornada laboral (decision de negocio D-5). Una fila es o bien la jornada de
/// un consultor (`consultantId`, `country` NULL) o bien la de un pais
/// (`country`, `consultantId` NULL). La fila `country = "Default"` es el valor
/// general que hereda cualquier pais sin configuracion propia.
/// `country` es unico: en PostgreSQL los NULL no chocan entre si, asi que las
/// filas por consultor conviven con las de pais bajo el mismo indice.
model CapacityConfig {
  id              String   @id @default(cuid())
  consultantId    String?  @unique
  country         String?  @unique
  hoursPerDay     Decimal  @default(8) @db.Decimal(4, 2)
  workDaysPerWeek Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultant Consultant? @relation(fields: [consultantId], references: [id], onDelete: Cascade)
}

// ─── Cierre Mensual ───────────────────────────────────────────────────────────

model MonthlySnapshot {
  id                String   @id @default(cuid())
  projectId         String
  year              Int
  month             Int
  baseCurrency      String
  laborCostActual   Decimal  @db.Decimal(18, 4)
  expensesActual    Decimal  @db.Decimal(18, 4)
  totalCostActual   Decimal  @db.Decimal(18, 4)
  revenueRecognized Decimal  @db.Decimal(18, 4)
  contractValue     Decimal  @db.Decimal(18, 4)
  grossMargin       Decimal  @db.Decimal(18, 4)
  grossMarginPct    Decimal  @db.Decimal(8, 4)
  hoursApproved     Decimal  @db.Decimal(10, 2)
  fxSnapshotJson    Json
  closedBy          String
  closedAt          DateTime @default(now())
  createdAt         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, year, month])
  @@index([year, month])
}

// ─── Alertas ──────────────────────────────────────────────────────────────────

model Alert {
  id           String        @id @default(cuid())
  type         AlertType
  severity     AlertSeverity @default(WARNING)
  projectId    String?
  consultantId String?
  message      String
  metadata     Json?
  resolvedAt   DateTime?
  resolvedBy   String?
  createdAt    DateTime      @default(now())

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultant Consultant? @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([type, resolvedAt])
  @@index([projectId])
  @@index([consultantId])
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  changedBy String
  before    Json?
  after     Json?
  diff      Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([changedBy])
  @@index([createdAt])
}

// ─── Gestión de Proyectos (PMP) ───────────────────────────────────────────────

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  plannedDate DateTime
  actualDate  DateTime?
  weight      Decimal         @default(0) @db.Decimal(5, 2)
  status      MilestoneStatus @default(PENDING)
  deliverable String?
  acceptedBy  String?
  note        String?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([plannedDate])
  @@index([status])
}

model Risk {
  id              String     @id @default(cuid())
  projectId       String
  title           String
  description     String?
  probability     Int
  impact          Int
  riskScore       Int
  category        String?
  owner           String?
  // Responsable cuando es un consultor del equipo (R-015). Convive con `owner`,
  // que sigue sirviendo para un responsable externo (cliente, tercero) sin
  // fila en `Consultant`. Nulable a propósito: no todo riesgo es de alguien
  // del equipo.
  consultantId    String?
  mitigationPlan  String?
  contingencyPlan String?
  status          RiskStatus @default(OPEN)
  identifiedAt    DateTime   @default(now())
  resolvedAt      DateTime?
  createdBy       String
  updatedAt       DateTime   @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consultant Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([riskScore])
  @@index([consultantId])
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String
  title       String
  description String?
  severity    IssueSeverity @default(MEDIUM)
  owner       String?
  status      IssueStatus   @default(OPEN)
  resolvedAt  DateTime?
  resolution  String?
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model ChangeRequest {
  id            String              @id @default(cuid())
  projectId     String
  title         String
  description   String
  type          ChangeRequestType
  impactScope   String?
  impactBudget  Decimal?            @db.Decimal(14, 2)
  impactDays    Int?
  requestedBy   String
  reviewedBy    String?
  status        ChangeRequestStatus @default(PENDING)
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

enum ExtraHourStatus {
  PENDING_PM
  /// OBSOLETO desde `20260930120000_aprobacion_unica_pm`. La aprobación de
  /// Finanzas dejó de existir: el PM aprueba y la solicitud queda APPROVED.
  /// El valor se conserva —sin producirse nunca— porque el histórico de
  /// `AuditLog` lo guarda dentro de `before`/`after` para siempre y quitarlo
  /// dejaría esos registros sin un estado legible. No escribir filas con él.
  PENDING_FINANCE
  APPROVED
  REJECTED
}

model ExtraHoursConfig {
  id                         String   @id @default(cuid())
  country                    String   @unique @default("Default")
  weeklyExtraHoursLimit      Decimal  @default(12) @db.Decimal(5, 2)
  diurnalMultiplier          Decimal  @default(1.25) @db.Decimal(4, 2)
  nocturnalMultiplier        Decimal  @default(1.75) @db.Decimal(4, 2)
  diurnalHolidayMultiplier   Decimal  @default(2.00) @db.Decimal(4, 2)
  nocturnalHolidayMultiplier Decimal  @default(2.50) @db.Decimal(4, 2)
  diurnalStart               String   @default("06:00:00")
  diurnalEnd                 String   @default("21:00:00")
  monthlyDivisor             Decimal  @default(220) @db.Decimal(5, 2)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

/// Umbrales del semáforo de salud (decisión de negocio D-7).
///
/// UNA sola fila, con `scope = "GENERAL"`. Son configuración de empresa, no de
/// proyecto: CPI y SPI son índices adimensionales donde 1,00 significa "según
/// plan" por definición, así que la banda que se tolera es apetito de riesgo de
/// la PMO, no una cláusula del contrato. El margen sí es por proyecto (D-2)
/// porque el objetivo de margen sale del tipo de contrato.
///
/// Si esta tabla está vacía se aplica `UMBRALES_SALUD_POR_DEFECTO`
/// (`utils/healthThresholds.ts`) y el API lo dice con `origen: "codigo"`.
model HealthThresholdConfig {
  id                String   @id @default(cuid())
  scope             String   @unique @default("GENERAL")
  /// CPI por debajo de este valor → Advertencia.
  cpiWarning        Decimal  @default(0.900) @db.Decimal(5, 3)
  /// CPI por debajo de este valor → Crítico.
  cpiCritical       Decimal  @default(0.750) @db.Decimal(5, 3)
  spiWarning        Decimal  @default(0.900) @db.Decimal(5, 3)
  spiCritical       Decimal  @default(0.750) @db.Decimal(5, 3)
  /// % de presupuesto alcanzado que ya es Advertencia, para los proyectos que
  /// no definen su propio `Project.budgetAlertPct`.
  budgetWarningPct  Decimal  @default(90) @db.Decimal(5, 2)
  /// % de presupuesto SUPERADO que es Crítico. General siempre.
  budgetCriticalPct Decimal  @default(100) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ExtraHourEntry {
  id                     String           @id @default(cuid())
  consultantId           String
  projectId              String?
  date                   DateTime
  startTime              String           
  endTime                String           
  diurnal                Decimal          @db.Decimal(6, 2)
  nocturnal              Decimal          @db.Decimal(6, 2)
  diurnalHoliday         Decimal          @db.Decimal(6, 2)
  nocturnalHoliday       Decimal          @db.Decimal(6, 2)
  totalHours             Decimal          @db.Decimal(6, 2)
  diurnalAmount          Decimal          @db.Decimal(14, 2)
  nocturnalAmount        Decimal          @db.Decimal(14, 2)
  diurnalHolidayAmount   Decimal          @db.Decimal(14, 2)
  nocturnalHolidayAmount Decimal          @db.Decimal(14, 2)
  totalAmount            Decimal          @db.Decimal(14, 2)
  observations           String?
  status                 ExtraHourStatus  @default(PENDING_PM)
  approvedBy             String?
  approvedAt             DateTime?
  rejectionNote          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  consultant             Consultant       @relation(fields: [consultantId], references: [id], onDelete: Restrict)
  project                Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([consultantId])
  @@index([projectId])
  @@index([status])
}

model Estimation {
  id                   String     @id @default(cuid())
  projectId            String?
  projectName          String
  createdAt            DateTime   @default(now())
  totalIdealHours      Decimal    @db.Decimal(10, 2)
  totalAdjustedHours   Decimal    @db.Decimal(10, 2)
  bufferPercentage     Decimal    @db.Decimal(5, 2)
  riskLevel            String     
  confidenceLevel      Decimal    @db.Decimal(5, 2)
  rawDataJson          String     @db.Text
  
  project              Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Activity {
  id             String      @id @default(cuid())
  title          String
  description    String?
  consultantId   String
  projectId      String?
  activityType   String      @default("project") // "project" | "personal" | "meeting" | "training" | "support" | "other"
  scheduledDate  DateTime
  dueDate        DateTime?
  completedDate  DateTime?
  estimatedHours Decimal     @db.Decimal(5, 2)
  actualHours    Decimal     @default(0) @db.Decimal(5, 2)
  status         String      @default("pending") // "pending" | "in_progress" | "completed" | "cancelled" | "blocked"
  priority       String      @default("medium")  // "low" | "medium" | "high" | "urgent"
  comments       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  consultant     Consultant  @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timeEntries    TimeEntry[]
  runningTimers  RunningTimer[]

  @@index([consultantId])
  @@index([projectId])
  @@index([scheduledDate])
}

model CustomHoliday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  country   String   @default("All") // "All" indica global/corporativo, o un país específico ("Colombia", "Peru", etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, country])
}

model ApprovalDelegation {
  id             String   @id @default(cuid())
  projectId      String
  fromUserEmail  String
  toUserEmail    String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([fromUserEmail])
  @@index([toUserEmail])
}

// ─── Observabilidad de los trabajos periódicos ────────────────────────────────

/// Rastro PERSISTENTE de cada ejecución de un trabajo periódico.
///
/// Existe porque el resultado del ciclo vivía solo en una variable de módulo
/// (`jobs.service.ts`) y el plan free de Render duerme el servicio a los 15
/// minutos de inactividad: tras cada siesta esa evidencia desaparecía y no
/// había forma de responder "¿cuándo fue la última vez que esto corrió?".
///
/// La tabla NO crece sin límite: `job-runs.service.ts` purga, después de cada
/// inserción, todo lo que exceda las últimas N ejecuciones de ese mismo
/// trabajo (ver RETENCION_POR_TRABAJO). Con los trabajos vigilados de hoy el
/// techo es de unos pocos cientos de filas.
model JobRun {
  id         String   @id @default(cuid())
  /// Nombre del trabajo: "assignment-maintenance", "alert-engine", "fx-sync",
  /// "approval-digest".
  jobName    String
  /// De dónde salió la ejecución: "arranque" | "intervalo" | "http".
  origin     String
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  ok         Boolean
  /// Mensaje del error cuando `ok = false`. Nunca lleva el stack.
  error      String?
  createdAt  DateTime @default(now())

  // Sirve a la consulta "última ejecución de cada trabajo" (DISTINCT ON).
  @@index([jobName, startedAt(sort: Desc)])
  // Sirve a la consulta "último ÉXITO de cada trabajo", que es la que decide
  // la frescura.
  @@index([jobName, ok, startedAt(sort: Desc)])
}

/// Configuración del resumen semanal de aprobaciones pendientes (R-020 + R-022).
///
/// Fila única (`scope = "GENERAL"`), igual que `HealthThresholdConfig`. Guarda
/// tres cosas distintas:
///  1. **Cuándo** sale el resumen (`enabled`, `sendWeekday`, `sendHourUtc`).
///  2. Si se conserva el **aviso inmediato** por cada solicitud de horas extra
///     (`immediateExtraHour`), que R-022 pedía reemplazar por el resumen.
///  3. `lastSentAt`, la marca que impide mandarlo dos veces en la misma semana.
///
/// `lastSentAt` NO es configuración: lo escribe el trabajo `approval-digest`
/// con un `updateMany` condicional, que es lo que hace de cerrojo entre varias
/// instancias del servidor. Por eso este módulo, a diferencia de los umbrales de
/// salud, **no tiene endpoint de borrado**: borrar la fila borraría también la
/// marca y abriría la puerta a un segundo envío en la misma semana.
model ApprovalDigestConfig {
  id                 String    @id @default(cuid())
  scope              String    @unique @default("GENERAL")
  /// `false` apaga el resumen por completo, sin tocar el código.
  enabled            Boolean   @default(true)
  /// Día ISO de envío: 1 = lunes … 7 = domingo.
  sendWeekday        Int       @default(1)
  /// Hora UTC de envío (0-23). 13 UTC = 08:00 en Colombia (UTC-5, sin horario
  /// de verano). Misma convención que el cron de tasas de cambio.
  sendHourUtc        Int       @default(13)
  /// Conservar el correo inmediato al PM por cada solicitud de horas extra.
  /// Por defecto `false`: R-022 pide el resumen "en vez de" ese aviso.
  immediateExtraHour Boolean   @default(false)
  /// Cuándo salió el último resumen. `null` = nunca.
  lastSentAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
