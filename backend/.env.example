PORT=4000
NODE_ENV=production

# Render public URL consumers. Multiple origins are supported as comma-separated URLs.
CORS_ORIGIN=https://your-frontend-name.vercel.app,http://localhost:5173

# Supabase/PostgreSQL.
# DATABASE_URL should use the pooled connection string for the running API.
# DIRECT_URL should use the direct/session connection string for Prisma migrations.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Local PostgreSQL examples. Use one pair in backend/.env when running locally.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_gestion_demo?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/app_gestion_demo?schema=public"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_gestion_demo?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5433/app_gestion_demo?schema=public"

# Authentication
AUTH_ENABLED=false
AUTH_DEMO_BYPASS=true
ADMIN_EMAIL=admin@yourcompany.com

# Microsoft Entra ID. Required when AUTH_ENABLED=true and AUTH_DEMO_BYPASS=false.
AZURE_AD_TENANT_ID=<entra-tenant-id>
AZURE_AD_AUDIENCE=api://<backend-app-id-uri-or-client-id>

# Notificaciones y Webhooks (Opcional - Simulado si no se proveen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-usuario@dominio.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM="App Gestión <noreply@synaptica.cc>"
PAYROLL_EMAIL=nomina@synaptica.co
SUPPORT_EMAIL=soporte@synaptica.co

# Webhooks entrantes de Microsoft Teams
TEAMS_PAYROLL_WEBHOOK_URL=https://synaptica.webhook.office.com/webhookb2/...
TEAMS_FEEDBACK_WEBHOOK_URL=https://synaptica.webhook.office.com/webhookb2/...

# Sincronización automática de tasas FX (POST /api/fx/sync).
# Token compartido que debe usar el Cron Job externo (Render Cron Job) para
# autenticarse; los usuarios ADMIN/FINANCE logueados pueden llamar la misma
# ruta con su sesión normal, sin necesitar este token.
FX_SYNC_TOKEN=<genera-un-valor-aleatorio-largo>
