VITE_API_URL=https://<app-service-del-backend>.azurewebsites.net
VITE_FORCE_LOCAL_AUTH=false
VITE_AZURE_TENANT_ID=<entra-tenant-id>
VITE_AZURE_CLIENT_ID=<entra-app-client-id>
# Opcional: sin definir, el frontend usa window.location.origin.
# VITE_AZURE_REDIRECT_URI=https://synatrack.synaptica.co
VITE_AZURE_API_SCOPE=api://<backend-app-id-uri-or-client-id>/access_as_user
