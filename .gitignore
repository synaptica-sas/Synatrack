node_modules/
dist/
*.log

.env
.env.*
!.env.example
!.env.*.example

**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Configuración real de Azure (identificadores de la suscripción). Se versiona
# solo la plantilla infra/azure.config.example.psd1. Ver infra/README.md.
infra/azure.config.psd1
# Secretos de la aplicación para secret-sync (plantilla: azure.secrets.example.psd1)
infra/azure.secrets.psd1
**/azure.secrets.psd1
infra/*.local.*
# Cualquier variante o copia ("azure.config - copia.psd1", "... copy.psd1"):
# solo se versionan las plantillas .example.psd1.
infra/azure.config*.psd1
!infra/azure.config.example.psd1
infra/azure.secrets*.psd1
!infra/azure.secrets.example.psd1
# Salidas de despliegue de scripts/azure.ps1
infra/.out/

# Grafo generado por graphify (se reconstruye con: graphify extract . --code-only)
graphify-out/

# Cache de Python de las skills
__pycache__/
*.pyc

# Datos locales de `supabase link` (por máquina)
supabase/.temp/

# Capturas y trazas del servidor MCP de Playwright (se regeneran)
.playwright-mcp/
